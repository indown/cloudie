<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Cloudie.App.Controls.CoverCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left"
    PointerEntered="OnPointerEntered" PointerExited="OnPointerExited"
    PointerPressed="OnPointerPressed" PointerReleased="OnPointerReleased"
    PointerCanceled="OnPointerExited" PointerCaptureLost="OnPointerExited">

    <!-- Four pixels of air around the cover: the item container clips at its bounds, and the hover scale needs room. -->
    <StackPanel Spacing="2" Width="{x:Bind HostSize, Mode=OneWay}">
        <Grid Width="{x:Bind HostSize, Mode=OneWay}" Height="{x:Bind HostSize, Mode=OneWay}">
            <!-- The cover scales up a little on hover (see code-behind). -->
            <Border x:Name="Cover" Width="{x:Bind Size, Mode=OneWay}" Height="{x:Bind Size, Mode=OneWay}"
                    CornerRadius="{x:Bind CornerRadius, Mode=OneWay}" Background="{ThemeResource CloudieSurfaceElevatedBrush}">
                <Grid>
                    <Image Source="{x:Bind ImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                    <Border x:Name="Shade" Background="#2E000000" Opacity="0" />
                </Grid>
            </Border>
            <!-- Play disc: a hint only, the item click does the work, so it is not hit-testable. -->
            <Border x:Name="PlayDisc" Width="40" Height="40" CornerRadius="20" Background="{ThemeResource CloudieAccentBrush}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" Opacity="0" IsHitTestVisible="False">
                <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="White" Margin="2,0,0,0" />
            </Border>
            <Border Background="#99000000" CornerRadius="10" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                    IsHitTestVisible="False" Visibility="{x:Bind Badge, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE768;" FontSize="9" Foreground="White" />
                    <TextBlock Text="{x:Bind Badge, Mode=OneWay}" FontSize="11" Foreground="White" />
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   MaxLines="{x:Bind TitleLines, Mode=OneWay}" Margin="4,0" />
        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Margin="4,2,4,0"
                   Visibility="{x:Bind Subtitle, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
    </StackPanel>
</UserControl>
