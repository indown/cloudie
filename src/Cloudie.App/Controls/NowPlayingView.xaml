<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Cloudie.App.Controls.NowPlayingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lyrics="using:Cloudie.Core.Lyrics">

    <Grid x:Name="Root">
        <!-- Artwork-tinted gradient backdrop. -->
        <Rectangle x:Name="Backdrop">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="PrimaryStop" Offset="0" Color="#FF3A3A48" />
                    <GradientStop x:Name="SecondaryStop" Offset="1" Color="#FF181820" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="1" Color="#59000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Padding="56,24,56,24" ColumnSpacing="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- Collapse chevron beside the window buttons -->
            <Button Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-36,-8,0,0"
                    Width="32" Height="32" CornerRadius="16" Background="#1FFFFFFF" BorderThickness="0" Click="Collapse_Click">
                <FontIcon Glyph="&#xE70D;" FontSize="12" Foreground="#D9FFFFFF" />
            </Button>

            <!-- Artwork + title -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="24" MaxWidth="520">
                <Border CornerRadius="16" MaxWidth="480" HorizontalAlignment="Center">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Image x:Name="Artwork" Stretch="UniformToFill"
                           Source="{x:Bind Player.CurrentTrack.Album.PicUrl, Mode=OneWay, Converter={StaticResource CoverUrl}, ConverterParameter=800}" />
                </Border>
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind Player.CurrentTrack.Name, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Player.CurrentTrack.ArtistNames, Mode=OneWay}" FontSize="16" Foreground="#C0FFFFFF" />
                    <TextBlock Text="{x:Bind Player.CurrentTrack.Album.Name, Mode=OneWay}" FontSize="14" Foreground="#99FFFFFF" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Background="#1FFFFFFF" BorderThickness="0" CornerRadius="16" Click="Like_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="{x:Bind LikeGlyph, Mode=OneWay}" FontSize="14" Foreground="White" />
                                <TextBlock Text="喜欢" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <Border Background="#1FFFFFFF" CornerRadius="16" Padding="12,6"
                                Visibility="{x:Bind SourceLabel, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{x:Bind SourceLabel, Mode=OneWay}" Foreground="White" FontSize="12" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Lyrics column -->
            <Grid Grid.Column="1">
                <TextBlock Text="{x:Bind EmptyLyricsText, Mode=OneWay}" Foreground="#99FFFFFF" FontSize="18"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{x:Bind HasLyrics, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}" />
                <ListView x:Name="LyricsList" ItemsSource="{x:Bind Lines, Mode=OneWay}" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="LyricsList_ItemClick"
                          Visibility="{x:Bind HasLyrics, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                          Padding="0,160,0,160">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="lyrics:LyricLine">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Text}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#80FFFFFF" />
                                <TextBlock Text="{x:Bind Translation}" FontSize="15" TextWrapping="Wrap" Foreground="#66FFFFFF"
                                           Visibility="{x:Bind Translation, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
