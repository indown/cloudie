<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Cloudie.App.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource CloudieSurfaceElevatedBrush}" BorderThickness="0,1,0,0"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="16,0" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="220" />
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="3*" MinWidth="180" />
        </Grid.ColumnDefinitions>

        <!-- Now playing summary; click opens the immersive page. -->
        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left"
                HorizontalContentAlignment="Left" Click="Cover_Click" IsEnabled="{x:Bind Player.HasCurrentTrack, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="{StaticResource CoverCornerRadius}" Background="{ThemeResource CloudieSurfaceBrush}">
                    <Image Source="{x:Bind Player.CurrentTrack.Album.PicUrl, Mode=OneWay, Converter={StaticResource CoverUrl}, ConverterParameter=112}" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2" MaxWidth="260">
                    <!-- Name trims inside a capped column so the mode badge stays beside it. -->
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MaxWidth="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Player.CurrentTrack.Name, Mode=OneWay}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1" Background="{ThemeResource CloudieAccentBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                                Visibility="{x:Bind ModeLabel, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{x:Bind ModeLabel, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource CloudieSurfaceBrush}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{x:Bind Player.CurrentTrack.ArtistNames, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{x:Bind SourceLabel, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource CloudieAccentBrush}"
                               Visibility="{x:Bind SourceLabel, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </StackPanel>
        </Button>

        <!-- Transport + progress -->
        <Grid Grid.Column="1" VerticalAlignment="Center" RowSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                <Button Style="{StaticResource PlayerIconButtonStyle}" Click="Shuffle_Click" ToolTipService.ToolTip="随机播放">
                    <FontIcon Glyph="&#xE8B1;" FontSize="14" Foreground="{x:Bind ShuffleBrush, Mode=OneWay}" />
                </Button>
                <Button Style="{StaticResource PlayerIconButtonStyle}" Click="Previous_Click" ToolTipService.ToolTip="上一首">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource PlayerIconButtonStyle}" Width="48" Height="48" CornerRadius="24"
                        Background="{ThemeResource CloudieTextPrimaryBrush}" Click="PlayPause_Click">
                    <FontIcon Glyph="{x:Bind PlayGlyph, Mode=OneWay}" FontSize="18" Foreground="{ThemeResource CloudieSurfaceBrush}" />
                </Button>
                <Button Style="{StaticResource PlayerIconButtonStyle}" Click="Next_Click" ToolTipService.ToolTip="下一首">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource PlayerIconButtonStyle}" Click="Repeat_Click" ToolTipService.ToolTip="循环模式">
                    <FontIcon Glyph="{x:Bind RepeatGlyph, Mode=OneWay}" FontSize="14" Foreground="{x:Bind RepeatBrush, Mode=OneWay}" />
                </Button>
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Player.Position, Mode=OneWay, Converter={StaticResource TimeSpanToText}}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="{x:Bind DurationSeconds, Mode=OneWay}"
                        Value="{x:Bind PositionSeconds, Mode=OneWay}" IsThumbToolTipEnabled="False"
                        ManipulationMode="All" PointerCaptureLost="ProgressSlider_PointerCaptureLost" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind Player.Duration, Mode=OneWay, Converter={StaticResource TimeSpanToText}}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- Volume, lyrics, queue -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource CloudieTextSecondaryBrush}" />
            <Slider Width="110" Minimum="0" Maximum="100" Value="{x:Bind VolumePercent, Mode=TwoWay}" VerticalAlignment="Center" />
            <Button Style="{StaticResource PlayerIconButtonStyle}" Click="Lyrics_Click" ToolTipService.ToolTip="歌词">
                <FontIcon Glyph="&#xE8D2;" FontSize="14" />
            </Button>
            <Button Style="{StaticResource PlayerIconButtonStyle}" ToolTipService.ToolTip="播放队列">
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <ListView ItemsSource="{x:Bind Player.Queue.Items, Mode=OneWay}" Width="320" MaxHeight="420"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="Queue_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,4">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ArtistNames}" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE8FD;" FontSize="14" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
