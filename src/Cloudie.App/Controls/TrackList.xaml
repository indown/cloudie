<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Cloudie.App.Controls.TrackList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cloudie.App.ViewModels">

    <!-- One context menu for every row (a per-row MenuFlyout cost 9 items plus icons per realised container).
         Opening reads the row from the flyout's Target. -->
    <UserControl.Resources>
        <MenuFlyout x:Key="RowMenu" Opening="RowMenu_Opening">
            <MenuFlyoutItem Text="播放" Click="PlayMenu_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="下一首播放" Click="PlayNextMenu_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B4;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="喜欢 / 取消喜欢" Click="LikeMenu_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB51;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="查看歌手" Click="ArtistMenu_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="查看专辑" Click="AlbumMenu_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE93C;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutSubItem Text="添加到歌单" Tag="add-to-playlist">
                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutSubItem.Icon>
            </MenuFlyoutSubItem>
            <MenuFlyoutItem Text="从歌单中移除" Click="RemoveMenu_Click" Visibility="Collapsed">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="心动模式" Click="HeartModeMenu_Click" Visibility="Collapsed">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB52;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.Resources>

    <Grid>
    <!-- ShowsScrollingPlaceholders off: the grey blocks it paints while a long list scrolls fast look like a veil.
         Header and Padding are the control's own, passed through: the page header scrolls with the rows, and the
         padding sits inside the scroller so the scrollbar stays at the edge of the page. -->
    <ListView x:Name="List" ItemsSource="{x:Bind Rows, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True"
              ItemClick="List_ItemClick" DoubleTapped="List_DoubleTapped" ShowsScrollingPlaceholders="False"
              Header="{x:Bind Header, Mode=OneWay}" Padding="{x:Bind Padding, Mode=OneWay}">
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinHeight" Value="56" />
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:TrackRow">
                <!-- Transparent (not null) background: otherwise only the text and image parts take the right-click. -->
                <Grid ColumnSpacing="12" Opacity="{x:Bind Opacity}" Background="Transparent" ContextFlyout="{StaticResource RowMenu}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind Number}" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}" />
                    <FontIcon Grid.Column="0" Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource CloudieAccentBrush}"
                              Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <!-- x:Phase: the cover is requested only once a row has stayed long enough to reach phase 2, so dragging
                         the scrollbar past hundreds of rows does not queue hundreds of downloads ahead of the rows you land on. -->
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="6" Background="{ThemeResource CloudieSurfaceElevatedBrush}">
                        <Image Source="{x:Bind CoverUrl, Converter={StaticResource CoverUrl}, ConverterParameter=88}" Stretch="UniformToFill" x:Phase="2" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"
                                       Visibility="{x:Bind Subtitle, Converter={StaticResource NullToVisibility}}" />
                            <Border Background="{ThemeResource CloudieSurfaceElevatedBrush}" CornerRadius="4" Padding="4,0"
                                    Visibility="{x:Bind GrayReason, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{x:Bind GrayReason}" FontSize="10" Foreground="{ThemeResource CloudieTextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Artists}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{x:Bind Album}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" x:Phase="1" />
                    <Button Grid.Column="4" Style="{StaticResource PlayerIconButtonStyle}" Width="32" Height="32"
                            Click="Like_Click" Tag="{x:Bind}" AutomationProperties.Name="喜欢" ToolTipService.ToolTip="喜欢 / 取消喜欢">
                        <FontIcon Glyph="&#xEB52;" FontSize="14"
                                  Foreground="{ThemeResource CloudieAccentBrush}"
                                  Visibility="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </Button>
                    <TextBlock Grid.Column="5" Text="{x:Bind Duration, Converter={StaticResource TimeSpanToText}}"
                               Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>

    <!-- 定位: floats over the list while the playing song's row is scrolled out of view (CanLocate pages only). -->
    <Button x:Name="LocateButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,60,20"
            Width="44" Height="44" CornerRadius="22" Padding="0" Opacity="0" IsHitTestVisible="False"
            Background="{ThemeResource CloudieSurfaceElevatedBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Translation="0,0,24" Click="Locate_Click"
            ToolTipService.ToolTip="定位到正在播放" AutomationProperties.Name="定位到正在播放">
        <Button.Shadow>
            <ThemeShadow />
        </Button.Shadow>
        <FontIcon Glyph="&#xE81D;" FontSize="16" Foreground="{ThemeResource CloudieAccentBrush}" />
    </Button>
    </Grid>
</UserControl>
