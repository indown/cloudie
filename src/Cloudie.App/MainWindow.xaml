<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cloudie.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cloudie.App.Controls"
    Title="Cloudie">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Placement Hidden: otherwise WinUI pops a "空格键" tooltip for the Space accelerator over the content. -->
    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="92" />
        </Grid.RowDefinitions>
        <!-- Shortcuts live on the root so they work on every page; the handlers skip text boxes and buttons. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Invoked="PlayPause_Invoked" />
            <KeyboardAccelerator Key="Right" Modifiers="Control" Invoked="Next_Invoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Control" Invoked="Previous_Invoked" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="Lyrics_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Search_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Title bar: the TitleBar control keeps its content clickable and leaves room for the caption buttons. -->
        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Cloudie" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索音乐、歌手、专辑" QueryIcon="Find" Width="360"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextChanged="SearchBox_TextChanged" SuggestionChosen="SearchBox_SuggestionChosen"
                                QuerySubmitted="SearchBox_QuerySubmitted" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button Padding="6,2" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                        ToolTipService.ToolTip="账号" AutomationProperties.Name="账号">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PersonPicture Width="28" Height="28" ProfilePicture="{x:Bind ViewModel.AvatarImage, Mode=OneWay}"
                                       DisplayName="{x:Bind ViewModel.AccountName, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.AccountName, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom" Opening="AccountMenu_Opening">
                            <MenuFlyoutItem x:Name="LoginItem" Text="扫码登录" Click="Login_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="LogoutItem" Text="退出登录" Click="Logout_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF3B1;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView x:Name="Navigation" Grid.Row="1"
                        IsBackButtonVisible="Visible"
                        BackRequested="Navigation_BackRequested"
                        IsSettingsVisible="True" OpenPaneLength="220" IsTitleBarAutoPaddingEnabled="False"
                        PaneDisplayMode="Auto" SelectionChanged="Navigation_SelectionChanged"
                        MenuItemsSource="{x:Bind ViewModel.MenuItems, Mode=OneWay}">
            <NavigationView.MenuItemTemplateSelector>
                <controls:NavigationItemTemplateSelector>
                    <controls:NavigationItemTemplateSelector.ItemTemplate>
                        <DataTemplate x:DataType="controls:NavigationEntry">
                            <NavigationViewItem Tag="{x:Bind}" AutomationProperties.Name="{x:Bind Title}">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="{x:Bind Glyph}" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </DataTemplate>
                    </controls:NavigationItemTemplateSelector.ItemTemplate>
                    <controls:NavigationItemTemplateSelector.EditableItemTemplate>
                        <DataTemplate x:DataType="controls:NavigationEntry">
                            <NavigationViewItem Tag="{x:Bind}" AutomationProperties.Name="{x:Bind Title}">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="{x:Bind Glyph}" />
                                </NavigationViewItem.Icon>
                                <NavigationViewItem.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="重命名" Click="RenamePlaylist_Click" Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="删除歌单" Click="DeletePlaylist_Click" Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </NavigationViewItem.ContextFlyout>
                            </NavigationViewItem>
                        </DataTemplate>
                    </controls:NavigationItemTemplateSelector.EditableItemTemplate>
                    <controls:NavigationItemTemplateSelector.HeaderTemplate>
                        <DataTemplate x:DataType="controls:NavigationEntry">
                            <NavigationViewItemHeader Content="{x:Bind Title}" />
                        </DataTemplate>
                    </controls:NavigationItemTemplateSelector.HeaderTemplate>
                    <controls:NavigationItemTemplateSelector.SeparatorTemplate>
                        <DataTemplate x:DataType="controls:NavigationEntry">
                            <NavigationViewItemSeparator />
                        </DataTemplate>
                    </controls:NavigationItemTemplateSelector.SeparatorTemplate>
                </controls:NavigationItemTemplateSelector>
            </NavigationView.MenuItemTemplateSelector>
            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>

        <!-- Immersive now-playing page slides over the browse UI, below the player bar. -->
        <controls:NowPlayingView x:Name="NowPlaying" Grid.Row="1"
                                 Visibility="{x:Bind ViewModel.NowPlayingVisibility, Mode=OneWay}" />

        <controls:PlayerBar Grid.Row="2" />

        <InfoBar x:Name="StatusBar" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
                 Severity="Informational" IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" MaxWidth="520" />

        <InfoBar x:Name="UpdateBar" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                 Severity="Success" Title="有新版本" IsOpen="{x:Bind ViewModel.IsUpdateOpen, Mode=TwoWay}"
                 Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}" MaxWidth="560">
            <InfoBar.ActionButton>
                <HyperlinkButton Content="前往下载" NavigateUri="{x:Bind ViewModel.UpdateUrl, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>
