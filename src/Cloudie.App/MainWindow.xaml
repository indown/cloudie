<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cloudie.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cloudie.App.Controls"
    xmlns:models="using:Cloudie.Core.Netease.Models"
    Title="Cloudie">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <!-- Title bar: the window buttons stay, our own search box sits beside them. -->
        <Grid x:Name="AppTitleBar" Height="48" VerticalAlignment="Top" Canvas.ZIndex="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="18" Height="18" />
                <TextBlock Text="Cloudie" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="搜索音乐、歌手、专辑" QueryIcon="Find"
                            Width="320" HorizontalAlignment="Center" VerticalAlignment="Center"
                            QuerySubmitted="SearchBox_QuerySubmitted" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" VerticalAlignment="Center">
                <PersonPicture Width="28" Height="28" ProfilePicture="{x:Bind ViewModel.AvatarImage, Mode=OneWay}"
                               DisplayName="{x:Bind ViewModel.AccountName, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.AccountName, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Navigation" Grid.Row="0" Margin="0,48,0,0"
                        IsBackButtonVisible="Visible"
                        BackRequested="Navigation_BackRequested"
                        IsSettingsVisible="True" OpenPaneLength="220" IsTitleBarAutoPaddingEnabled="False"
                        PaneDisplayMode="Left" SelectionChanged="Navigation_SelectionChanged"
                        MenuItemsSource="{x:Bind ViewModel.MenuItems, Mode=OneWay}">
            <NavigationView.MenuItemTemplateSelector>
                <controls:NavigationItemTemplateSelector>
                    <controls:NavigationItemTemplateSelector.ItemTemplate>
                        <DataTemplate x:DataType="controls:NavigationEntry">
                            <NavigationViewItem Content="{x:Bind Title}" Tag="{x:Bind}">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="{x:Bind Glyph}" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </DataTemplate>
                    </controls:NavigationItemTemplateSelector.ItemTemplate>
                    <controls:NavigationItemTemplateSelector.HeaderTemplate>
                        <DataTemplate x:DataType="controls:NavigationEntry">
                            <NavigationViewItemHeader Content="{x:Bind Title}" />
                        </DataTemplate>
                    </controls:NavigationItemTemplateSelector.HeaderTemplate>
                    <controls:NavigationItemTemplateSelector.SeparatorTemplate>
                        <DataTemplate x:DataType="controls:NavigationEntry">
                            <NavigationViewItemSeparator />
                        </DataTemplate>
                    </controls:NavigationItemTemplateSelector.SeparatorTemplate>
                </controls:NavigationItemTemplateSelector>
            </NavigationView.MenuItemTemplateSelector>
            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>

        <!-- Immersive now-playing page slides over the browse UI, below the player bar. -->
        <controls:NowPlayingView x:Name="NowPlaying" Grid.Row="0" Margin="0,0,0,0"
                                 Visibility="{x:Bind ViewModel.Player.ShowNowPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <controls:PlayerBar Grid.Row="1" />

        <InfoBar x:Name="StatusBar" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
                 Severity="Informational" IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" MaxWidth="520" />
    </Grid>
</Window>
