<?xml version="1.0" encoding="utf-8"?>
<!--
    Lightweight-styling overrides for the round play / pause button, merged into the button's own Resources.
    DefaultButtonStyle swaps the background for the system hover colour on pointer-over, which made the dark
    disc vanish into the bar; these keep it a slightly lighter shade of the same colour instead.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF3A3A3E" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF55555A" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFF7F7F8" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFF7F7F8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFDCDCDC" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFC4C4C4" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF121212" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF121212" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
