<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette: a quiet dark surface, white text, a single warm accent for the active lyric and play state. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="CloudieSurface">#FFF7F7F8</Color>
            <Color x:Key="CloudieSurfaceElevated">#FFFFFFFF</Color>
            <Color x:Key="CloudieSidebar">#FFEFEFF2</Color>
            <Color x:Key="CloudieTextPrimary">#FF1C1C1E</Color>
            <Color x:Key="CloudieTextSecondary">#99000000</Color>
            <Color x:Key="CloudieAccent">#FFC98A2B</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="CloudieSurface">#FF121212</Color>
            <Color x:Key="CloudieSurfaceElevated">#FF1C1C1E</Color>
            <Color x:Key="CloudieSidebar">#FF171718</Color>
            <Color x:Key="CloudieTextPrimary">#FFF5F5F5</Color>
            <Color x:Key="CloudieTextSecondary">#99FFFFFF</Color>
            <Color x:Key="CloudieAccent">#FFE9B872</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="CloudieSurfaceBrush" Color="{ThemeResource CloudieSurface}" />
    <SolidColorBrush x:Key="CloudieSurfaceElevatedBrush" Color="{ThemeResource CloudieSurfaceElevated}" />
    <SolidColorBrush x:Key="CloudieSidebarBrush" Color="{ThemeResource CloudieSidebar}" />
    <SolidColorBrush x:Key="CloudieTextPrimaryBrush" Color="{ThemeResource CloudieTextPrimary}" />
    <SolidColorBrush x:Key="CloudieTextSecondaryBrush" Color="{ThemeResource CloudieTextSecondary}" />
    <SolidColorBrush x:Key="CloudieAccentBrush" Color="{ThemeResource CloudieAccent}" />

    <x:Double x:Key="PlayerBarHeight">80</x:Double>
    <CornerRadius x:Key="CoverCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,12" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource CloudieTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="PlayerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <Style x:Key="CoverCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource CloudieSurfaceElevatedBrush}" />
    </Style>
</ResourceDictionary>
