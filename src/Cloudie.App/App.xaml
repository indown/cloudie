<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Cloudie.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Cloudie.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:TimeSpanToTextConverter x:Key="TimeSpanToText" />
            <converters:CoverUrlConverter x:Key="CoverUrl" />
            <converters:PlayCountConverter x:Key="PlayCount" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
