<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cloudie.App.Views.TrackListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cloudie.App.Controls">

    <Grid Padding="32,16,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="200" Height="200" CornerRadius="{StaticResource CardCornerRadius}" Background="{ThemeResource CloudieSurfaceElevatedBrush}">
                <Image Source="{x:Bind ViewModel.CoverUrl, Mode=OneWay, Converter={StaticResource CoverUrl}, ConverterParameter=400}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" FontSize="13" />
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxLines="3" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.PlayAllCommand}" Style="{StaticResource AccentButtonStyle}" CornerRadius="18" Padding="20,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="播放全部" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="40" Height="40" VerticalAlignment="Top" Margin="0,40,0,0" />
            <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}" VerticalAlignment="Top" />
            <controls:TrackList x:Name="List" Rows="{x:Bind ViewModel.Rows, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
