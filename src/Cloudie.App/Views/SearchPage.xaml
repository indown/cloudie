<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cloudie.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cloudie.App.Controls"
    xmlns:models="using:Cloudie.Core.Netease.Models">

    <ScrollViewer Padding="32,16,32,24">
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource PageTitleStyle}">
                <Run Text="搜索" /><Run Text="“" /><Run Text="{x:Bind ViewModel.Query, Mode=OneWay}" /><Run Text="”" />
            </TextBlock>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

            <TextBlock Text="歌手" Style="{StaticResource SectionTitleStyle}" Visibility="{x:Bind HasArtists, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <GridView ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Artist_ItemClick"
                      ItemContainerStyle="{StaticResource CardItemStyle}" Margin="-4,0,0,0">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:ArtistSummary">
                        <StackPanel Width="120" Spacing="6" Margin="0,0,8,12" HorizontalAlignment="Center">
                            <Border Width="100" Height="100" CornerRadius="50" Background="{ThemeResource CloudieSurfaceElevatedBrush}">
                                <Image Source="{x:Bind ImageUrl, Converter={StaticResource CoverUrl}, ConverterParameter=200}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{x:Bind Name}" FontSize="13" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock Text="专辑" Style="{StaticResource SectionTitleStyle}" Visibility="{x:Bind HasAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <GridView ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Album_ItemClick"
                      ItemContainerStyle="{StaticResource CardItemStyle}" Margin="-4,0,0,0">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:AlbumSummary">
                        <controls:CoverCard ImageUrl="{x:Bind PicUrl}" Title="{x:Bind Name}" Subtitle="{x:Bind ArtistName}" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock Text="歌曲" Style="{StaticResource SectionTitleStyle}" />
            <controls:TrackList x:Name="List" Rows="{x:Bind ViewModel.Songs, Mode=OneWay}" />

            <TextBlock Text="歌单" Style="{StaticResource SectionTitleStyle}" Visibility="{x:Bind HasPlaylists, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <GridView ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Playlist_ItemClick"
                      ItemContainerStyle="{StaticResource CardItemStyle}" Margin="-4,0,0,0">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistSummary">
                        <controls:CoverCard ImageUrl="{x:Bind CoverUrl}" Title="{x:Bind Name}" TitleLines="2"
                                            Badge="{x:Bind Plays, Converter={StaticResource PlayCount}}" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
