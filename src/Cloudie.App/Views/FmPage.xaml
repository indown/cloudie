<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cloudie.App.Views.FmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32,16,32,24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24" MaxWidth="760">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="私人 FM" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="按你的口味一直放下去，不喜欢的歌直接丢掉" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>

            <Button Content="开始收听" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" CornerRadius="20" Padding="28,10"
                    Click="Start_Click" Visibility="{x:Bind IsIdle, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Orientation="Horizontal" Spacing="32" HorizontalAlignment="Center"
                        Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border Width="260" Height="260" CornerRadius="16" Background="{ThemeResource CloudieSurfaceElevatedBrush}">
                    <Image Source="{x:Bind Player.CurrentTrack.Album.PicUrl, Mode=OneWay, Converter={StaticResource CoverUrl}, ConverterParameter=520}" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="8" MaxWidth="380">
                    <TextBlock Text="{x:Bind Player.CurrentTrack.Name, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                    <TextBlock Text="{x:Bind Player.CurrentTrack.ArtistNames, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" FontSize="14" />
                    <TextBlock Text="{x:Bind Player.CurrentTrack.Album.Name, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="44" Height="44" Click="Trash_Click" ToolTipService.ToolTip="不喜欢" AutomationProperties.Name="不喜欢">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="44" Height="44" Click="Like_Click" ToolTipService.ToolTip="喜欢" AutomationProperties.Name="喜欢">
                            <FontIcon Glyph="{x:Bind LikeGlyph, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource CloudieAccentBrush}" />
                        </Button>
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="56" Height="56" CornerRadius="28"
                                Background="{ThemeResource CloudieTextPrimaryBrush}" Click="PlayPause_Click" AutomationProperties.Name="播放 / 暂停">
                            <Button.Resources>
                                <ResourceDictionary Source="ms-appx:///Styles/PlayButton.xaml" />
                            </Button.Resources>
                            <FontIcon Glyph="{x:Bind PlayGlyph, Mode=OneWay}" FontSize="20" Foreground="{ThemeResource CloudieSurfaceBrush}" />
                        </Button>
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Width="44" Height="44" Click="Next_Click" ToolTipService.ToolTip="下一首" AutomationProperties.Name="下一首">
                            <FontIcon Glyph="&#xE893;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
