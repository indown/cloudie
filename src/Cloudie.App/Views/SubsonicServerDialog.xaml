<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Cloudie.App.Views.SubsonicServerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="添加 Navidrome 服务器"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="Save_Click">

    <StackPanel Spacing="12" MinWidth="360">
        <TextBox x:Name="NameField" Header="名称" PlaceholderText="可不填，默认显示域名" MaxLength="40" TextChanged="Text_Changed" />
        <TextBox x:Name="UrlField" Header="地址" PlaceholderText="https://music.example.com" TextChanged="Text_Changed" />
        <TextBox x:Name="UserField" Header="用户名" TextChanged="Text_Changed" />
        <PasswordBox x:Name="PasswordField" Header="密码" PasswordChanged="Password_Changed" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="TestButton" Content="测试连接" Click="Test_Click" />
            <TextBlock x:Name="TestText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
