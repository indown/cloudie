<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cloudie.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Cloudie.Core.Netease.Models"
    xmlns:controls="using:Cloudie.App.Controls"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="32,16,32,24">
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <!-- Daily songs strip (logged in) -->
            <StackPanel Visibility="{x:Bind ViewModel.HasDailySongs, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <TextBlock Text="每日推荐" Style="{StaticResource SectionTitleStyle}" />
                    <HyperlinkButton Content="查看全部" HorizontalAlignment="Right" Click="AllDaily_Click" />
                </Grid>
                <GridView ItemsSource="{x:Bind ViewModel.DailySongs, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Daily_ItemClick"
                          ItemContainerStyle="{StaticResource CardItemStyle}" Margin="-4,0,0,0">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <controls:CoverCard ImageUrl="{x:Bind Album.PicUrl}" Title="{x:Bind Name}" Subtitle="{x:Bind ArtistNames}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <TextBlock Text="推荐歌单" Style="{StaticResource SectionTitleStyle}" />
            <GridView ItemsSource="{x:Bind ViewModel.RecommendedPlaylists, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Playlist_ItemClick"
                      ItemContainerStyle="{StaticResource CardItemStyle}" Margin="-4,0,0,0">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistSummary">
                        <controls:CoverCard Size="170" ImageUrl="{x:Bind CoverUrl}" Title="{x:Bind Name}" TitleLines="2"
                                            Badge="{x:Bind Plays, Converter={StaticResource PlayCount}}" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock Text="排行榜" Style="{StaticResource SectionTitleStyle}" />
            <GridView ItemsSource="{x:Bind ViewModel.Toplists, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Toplist_ItemClick"
                      ItemContainerStyle="{StaticResource CardItemStyle}" Margin="-4,0,0,0">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:ToplistItem">
                        <controls:CoverCard ImageUrl="{x:Bind CoverImgUrl}" Title="{x:Bind Name}" Subtitle="{x:Bind UpdateFrequency}" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
