<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cloudie.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Cloudie.Core.Netease.Models"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="32,16,32,24">
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <!-- Daily songs strip (logged in) -->
            <StackPanel Visibility="{x:Bind ViewModel.HasDailySongs, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <TextBlock Text="每日推荐" Style="{StaticResource SectionTitleStyle}" />
                    <HyperlinkButton Content="查看全部" HorizontalAlignment="Right" Click="AllDaily_Click" />
                </Grid>
                <GridView ItemsSource="{x:Bind ViewModel.DailySongs, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Daily_ItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <StackPanel Width="150" Spacing="6" Margin="0,0,8,12">
                                <Border Width="150" Height="150" CornerRadius="{StaticResource CardCornerRadius}" Background="{ThemeResource CloudieSurfaceElevatedBrush}">
                                    <Image Source="{x:Bind Album.PicUrl, Converter={StaticResource CoverUrl}, ConverterParameter=300}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ArtistNames}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <TextBlock Text="推荐歌单" Style="{StaticResource SectionTitleStyle}" />
            <GridView ItemsSource="{x:Bind ViewModel.RecommendedPlaylists, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Playlist_ItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistSummary">
                        <StackPanel Width="170" Spacing="6" Margin="0,0,8,12">
                            <Grid Width="170" Height="170">
                                <Border CornerRadius="{StaticResource CardCornerRadius}" Background="{ThemeResource CloudieSurfaceElevatedBrush}">
                                    <Image Source="{x:Bind CoverUrl, Converter={StaticResource CoverUrl}, ConverterParameter=340}" Stretch="UniformToFill" />
                                </Border>
                                <Border Background="#99000000" CornerRadius="10" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE768;" FontSize="9" Foreground="White" />
                                        <TextBlock Text="{x:Bind Plays, Converter={StaticResource PlayCount}}" FontSize="11" Foreground="White" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="{x:Bind Name}" FontSize="13" TextWrapping="Wrap" MaxLines="2" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock Text="排行榜" Style="{StaticResource SectionTitleStyle}" />
            <GridView ItemsSource="{x:Bind ViewModel.Toplists, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Toplist_ItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:ToplistItem">
                        <StackPanel Width="150" Spacing="6" Margin="0,0,8,12">
                            <Border Width="150" Height="150" CornerRadius="{StaticResource CardCornerRadius}" Background="{ThemeResource CloudieSurfaceElevatedBrush}">
                                <Image Source="{x:Bind CoverImgUrl, Converter={StaticResource CoverUrl}, ConverterParameter=300}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind UpdateFrequency}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
