<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Cloudie.App.Views.LoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="登录网易云音乐"
    CloseButtonText="取消"
    DefaultButton="Close">

    <StackPanel Spacing="16" HorizontalAlignment="Center" MinWidth="280">
        <Border Width="220" Height="220" Background="White" CornerRadius="12" Padding="10">
            <Image Source="{x:Bind ViewModel.QrImage, Mode=OneWay}" Stretch="Uniform" />
        </Border>
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
</ContentDialog>
